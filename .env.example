# Copy this file to .env for local development only. Never store credentials here.
APP_ENV=development
NODE_ENV=development

# Microsoft Entra ID frontend placeholders only. Put actual local values only in ignored .env.
VITE_ENTRA_TENANT_ID=replace_me
VITE_ENTRA_CLIENT_ID=replace_me
VITE_ENTRA_API_CLIENT_ID=replace_me
VITE_ENTRA_REDIRECT_URI=http://localhost:5173
VITE_ENTRA_API_SCOPE=api://replace_me/access_as_user
VITE_API_BASE_URL=/api

# Local placeholder only. Do not point this at an existing or production SQL Server.
DATABASE_URL="sqlserver://localhost:1433;database=access_management_portal_local;user=local_user;password=replace_me;encrypt=true;trustServerCertificate=true"

# Mandatory pilot safety controls. The application must fail closed if these change.
LEGACY_INTEGRATION_MODE=READ_ONLY
ENABLE_SHAREPOINT_WRITE=false
ENABLE_LEGACY_SQL_WRITE=false
ENABLE_VSTS_WRITE=false
ENABLE_ACCESS_PROVISIONING=false
ENABLE_ACCESS_REVOCATION=false
ENABLE_AUTOMATION=false
