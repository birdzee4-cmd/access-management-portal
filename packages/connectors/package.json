  },
  "dependencies": {
    "@access-portal/contracts": "*",
    "@access-portal/shared": "*",
    "mssql": "^12.7.0"
  },
  "devDependencies": {
    "@types/mssql": "^12.3.0",
    "@types/node": "^22.20.1",
    "typescript": "^5.8.2"
  }
}
