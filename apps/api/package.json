{
  "name": "@access-portal/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/src/functions/*.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/services/services.test.js dist-test/services/legacy-matrix-analysis.test.js dist-test/services/legacy-catalog-mapping.test.js dist-test/services/legacy-approval-mapping.test.js dist-test/services/legacy-user-request.service.test.js dist-test/services/legacy-user-request-detail.service.test.js dist-test/auth/authentication.test.js dist-test/legacy/legacy-matrix-api.test.js dist-test/legacy/legacy-user-request-api.test.js dist-test/legacy/legacy-user-request-detail-api.test.js",
    "start": "npm run build && func start"
  },
  "dependencies": {
    "@access-portal/connectors": "*",
    "@access-portal/contracts": "*",
    "@access-portal/database": "*",
    "@access-portal/shared": "*",
    "@azure/functions": "^4.7.2",
    "jose": "^6.2.10"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "typescript": "^5.8.2"
  }
}
